# CivicPulse AI - Secrets Configuration Template
# To use with your real Gemini API key:
# 1. Copy this file to `.streamlit/secrets.toml`
# 2. Replace the placeholder with your actual Google Gemini API key
# 3. Alternatively, export the environment variable: `export GEMINI_API_KEY="your-key"`

GEMINI_API_KEY = "your-actual-gemini-api-key-here"
